{
  "name": "code-laundry",
  "version": "0.1.0",
  "description": "Deterministic-first sanitizer for AI-generated code, exposed as an MCP server and CLI",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "code-quality",
    "static-analysis",
    "security",
    "linter"
  ],
  "homepage": "https://github.com/stevenleon30/code-laundry#readme",
  "bugs": {
    "url": "https://github.com/stevenleon30/code-laundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stevenleon30/code-laundry.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "code-laundry": "dist/cli/index.js",
    "codelaundry": "dist/cli/index.js",
    "codelaundry-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "rules"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evals": "tsx evals/run.ts",
    "mcp": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli/index.ts",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "version": "node scripts/sync-plugin-version.mjs && git add plugin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "diff": "^9.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
